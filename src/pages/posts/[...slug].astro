---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { allPosts, postUrl, fmtDate, freshness, related, slugify } from '../../lib/posts';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await allPosts();
  // The id is the file name with its original casing, so the URLs Jekyll
  // produced stay identical character for character.
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const posts = await allPosts();
const f = freshness(post);
const rel = related(post, posts);
const cat = post.data.categories[0] ?? 'Note';
// First tag that does not just repeat the category, so the trail
// does not read "Microsoft / Microsoft".
const leaf = post.data.tags.find((t) => t.toLowerCase() !== cat.toLowerCase()) ?? post.data.tags[0] ?? 'Post';
const meta = [
  post.data.author ?? SITE.author,
  fmtDate(post.data.date),
  post.data.tags.join(', '),
].filter(Boolean).join(' · ');

const ageText = f.years >= 1
  ? `This post is ${f.years === 1 ? 'a year' : f.years + ' years'} old.`
  : `This post is ${f.months} months old.`;
---

<Base title={post.data.title} description={post.data.description} type="article" date={post.data.date}>
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/">← Search</a>
    <span class="s">/</span>
    <a href={`/categories/${slugify(cat)}/`}>{cat}</a>
    <span class="s">/</span>
    <span>{leaf}</span>
  </nav>

  <article>
    <p class="kicker">{post.data.categories.join(' · ') || 'Note'}</p>
    <h1>{post.data.title}</h1>
    <p class="byline">{meta}</p>

    {post.data.verified && (
      <p class="verified">
        <span><b>Verified</b> {fmtDate(post.data.verified)}</span>
        {post.data.testedAgainst && <span><b>Tested against</b> {post.data.testedAgainst}</span>}
        {post.data.effort && <span><b>Takes</b> {post.data.effort}</span>}
      </p>
    )}

    {f.isStale && (
      <div class="decay">
        <span class="tag">Age notice</span>
        <strong>{ageText}</strong>{' '}
        Portals and menu paths may have moved since then. Tested it recently?
        {' '}
        <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Still current: ' + post.data.title)}`}>
          Drop me a line
        </a>{' '}and I'll refresh the verified date.
      </div>
    )}

    <div class="body">
      <Content />

      {rel.length > 0 && (
        <div class="rel">
          <h2 class="res-head">Often read next</h2>
          {rel.map((p) => {
            const rf = freshness(p);
            return (
              <a class="hit" href={postUrl(p)}>
                <div class="t">{p.data.title}</div>
                <div class="m">
                  <span>{p.data.tags.slice(0, 3).join(' · ')}</span>
                  <span class={rf.isVerified ? 'age ok' : 'age'}>{rf.label}</span>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </article>
</Base>
