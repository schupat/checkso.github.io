---
import Base from '../layouts/Base.astro';
import { allPosts, postUrl, fmtDate, freshness } from '../lib/posts';
const posts = await allPosts();
const years = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!years.has(y)) years.set(y, []);
  years.get(y)!.push(p);
}
const sorted = [...years.entries()].sort((a, b) => b[0] - a[0]);
---
<Base title="Archiv" description="Alle Notizen nach Jahr.">
  <h1 class="page-h">Archiv</h1>
  <p class="page-sub">{posts.length} Notizen, neueste zuerst.</p>
  {sorted.map(([year, list]) => (
    <section>
      <h2 class="year-h">{year} — {list.length} {list.length === 1 ? 'Notiz' : 'Notizen'}</h2>
      <div class="hitlist">
        {list.map((p) => {
          const f = freshness(p);
          return (
            <a class="hit" href={postUrl(p)}>
              <div class="t">{p.data.title}</div>
              <div class="m">
                <span>{p.data.tags.slice(0, 4).join(' · ')}</span>
                <span>{fmtDate(p.data.date)}</span>
                <span class={f.isVerified ? 'age ok' : 'age'}>{f.label}</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ))}
</Base>
