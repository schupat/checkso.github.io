---
import Base from '../../layouts/Base.astro';
import { allPosts, categoryCounts, slugify } from '../../lib/posts';
const posts = await allPosts();
const cats = categoryCounts(posts);
---
<Base title="Categories" description="Every category on this blog.">
  <h1 class="page-h">Categories</h1>
  <p class="page-sub">The coarse split. For something more specific, <a href="/tags/">topics</a> work better.</p>
  <div class="taglist">
    {cats.map(([c, n]) => (
      <a class="chip" href={`/categories/${slugify(c)}/`}>{c} <b>{n}</b></a>
    ))}
  </div>
</Base>
