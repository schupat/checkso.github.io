---
import { SITE } from '../lib/site';
import '../styles/desktop.css';
const title = 'Desktop mode';
const desc = 'A small desktop environment with a shell that reads the actual posts on this site.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE.title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={`${SITE.url}/desktop/`} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/assets/img/favicons/favicon.svg" />
    <meta name="theme-color" content="#10151c" />
  </head>
  <body>
    <div id="wall"></div>
    <div class="wall-mark">schuele<small>DESKTOP MODE</small></div>

    <div id="panel">
      <span class="tag">schuele.xyz</span>
      <span class="ws"><b class="on">1</b><b>2</b><b>3</b></span>
      <span class="sep"></span>
      <span class="stat">
        <span>posts <i id="stat-posts">–</i></span>
        <span>stale <i id="stat-stale">–</i></span>
        <span id="clock">–</span>
      </span>
      <a class="back" href="/">← blog</a>
    </div>

    <main id="desk"></main>

    <div id="toosmall">
      <div class="box">
        <h1>This one wants a bigger screen.</h1>
        <p>
          Desktop mode puts draggable windows and a shell on the page, which stops being
          fun below roughly 720&nbsp;pixels. Come back on a laptop — or just read the blog,
          which is the point anyway.
        </p>
        <a href="/">← back to schuele.xyz</a>
      </div>
    </div>

    <nav id="dock" aria-label="Dock"></nav>

    <script>import '../scripts/desktop.ts';</script>
  </body>
</html>
