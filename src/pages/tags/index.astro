---
import Base from '../../layouts/Base.astro';
import { allPosts, tagCounts, slugify } from '../../lib/posts';
const posts = await allPosts();
const tags = tagCounts(posts);
---
<Base title="Topics" description="Every topic on this blog, most used first.">
  <h1 class="page-h">Topics</h1>
  <p class="page-sub">{tags.length} topics across {posts.length} posts. Most used first.</p>
  <div class="taglist">
    {tags.map(([t, n]) => (
      <a class="chip" href={`/tags/${slugify(t)}/`}>{t} <b>{n}</b></a>
    ))}
  </div>
</Base>
