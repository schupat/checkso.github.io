---
import { SITE, NAV } from '../lib/site';
const here = Astro.url.pathname;
---
<header class="site">
  <a class="brand" href="/">schuele<span>.xyz</span></a>
  <nav class="site" aria-label="Hauptnavigation">
    {NAV.map((n) => (
      <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a>
    ))}
    <button class="theme-btn" id="theme-btn" type="button" aria-label="Design umschalten">Terminal</button>
  </nav>
</header>
