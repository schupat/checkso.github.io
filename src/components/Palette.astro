---
// Command palette. The search index is generated at build time as /search.json
// and only fetched the first time the palette or the search field is used.
---
<div class="scrim" id="scrim"></div>
<div class="palette" id="palette" role="dialog" aria-modal="true" aria-label="Search and commands">
  <input id="pq" type="text" placeholder="Search or type a command…" autocomplete="off" spellcheck="false" aria-label="Search or type a command" />
  <div class="plist" id="plist" role="listbox"></div>
  <div class="pfoot"><span>↑↓ Navigate</span><span>⏎ Open</span><span>Esc Close</span></div>
</div>
